# 서비스 서버의 /opt/ttg/.env 로 복사해서 값을 채운다. 이 파일(.env)은 절대 커밋하지 말 것.
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
API_TAG=latest
UI_TAG=latest
# RDS 콘솔 → ttg-db → 연결 및 보안 → 엔드포인트
DB_HOST=ttg-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USERNAME=dbadmin
DB_PASSWORD=change-me
# openssl rand -base64 64 | tr -d '\n' 로 새로 만든다
JWT_SECRET=change-me
